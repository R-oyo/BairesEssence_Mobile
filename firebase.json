{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "ignore": [
      "node_modules",
      ".git",
      "scripts",
      "*.local"
    ]
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/createMercadoPagoPreference", "function": "api" },
      { "source": "/createPaypalOrder", "function": "api" },
      { "source": "/webhook/mercadopago", "function": "api" },
      { "source": "/paypalWebhook", "function": "api" }
    ]
  }
}
